class Solution {
    static boolean isPrime(int n) {
        // code here
        // if (n <= 1) {
        //     return false;
        // }
        // if (n == 2) {
        //     return true;
        // }
        // if (n % 2 == 0) {
        //     return false; // Exclude all other even numbers
        // }

        // // Check odd factors up to the square root of the number
        // for (int i = 3; i <= Math.sqrt(n); i += 2) {
        //     if (n % i == 0) {
        //         return false;
        //     }
        // }
        // return true;
        
        // 1. Handle base cases immediately
        if (n <= 1) return false;
        if (n <= 3) return true; // 2 and 3 are prime

        // 2. Eliminate multiples of 2 and 3
        if (n % 2 == 0 || n % 3 == 0) return false;

        // 3. Fast square root boundary check
        int limit = (int) Math.sqrt(n);

        // 4. Check factors using 6k +/- 1 step optimization
        // All primes greater than 3 are of the form (6k +/- 1)
        for (int i = 5; i <= limit; i += 6) {
            if (n % i == 0 || n % (i + 2) == 0) {
                return false;
            }
        }

        return true;
    }
}
