        // int pow = (int) Math.pow(num, reversed);
        // return pow;

        //  highly optimized
        long base = n;
                long reversed = 0;
                int temp = n;
                long MOD = 1000000007L; // Standard modulo to prevent overflow

                // 1. Optimized Reversing Loop
                while (temp > 0) {
                    reversed = (reversed * 10) + (temp % 10);
                    temp /= 10;
                }

                // 2. Performance-Optimized Binary Exponentiation O(log R)
                long result = 1;
                base = base % MOD; 

                while (reversed > 0) {
                    // If the current bit of reversed is 1, multiply the base into the result
                    if ((reversed & 1) == 1) {
                        result = (result * base) % MOD;
                    }
                    // Square the base and shift the exponent to the right by 1 bit
                    base = (base * base) % MOD;
                    reversed >>= 1; 
                }

                return (int) result;
    }
